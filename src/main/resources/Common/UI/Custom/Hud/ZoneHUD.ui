@EssenceBarFill = "NewEssenceBarFill.png";

Group {
  LayoutMode: Center;

  Group #ZoneHudRoot {
    Anchor: (Width: 610, Top: 36);
    LayoutMode: Top;

    Group #ZoneBar {
      Anchor: (Width: 610, Height: 26, Left: 0, Top: 0);
      Background: (Color: #00000088);
      LayoutMode: Center;
      Padding: (Vertical: 0, Horizontal: 12);

      Group #InfoRow {
        Anchor: (Height: 22);
        LayoutMode: Left;

        Label #ZoneName {
          Text: "Zone Info - 0m";
          Style: (
            FontSize: 12,
            RenderBold: true,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 150, Height: 22);
        }

        Label #Separator1 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #Essence {
          Text: "Essence: 0/1000";
          Style: (
            FontSize: 12,
            RenderBold: true,
            TextColor: #FFFF55,
            Alignment: Center
          );
          Anchor: (Width: 130, Height: 22);
        }

        Label #Separator2 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #HPMult {
          Text: "HP: x1.0";
          Style: (
            FontSize: 12,
            TextColor: #FF5555,
            Alignment: Center
          );
          Anchor: (Width: 70, Height: 22);
        }

        Label #Separator3 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #DMGMult {
          Text: "DMG: x1.0";
          Style: (
            FontSize: 12,
            TextColor: #FFAA55,
            Alignment: Center
          );
          Anchor: (Width: 80, Height: 22);
        }

        Label #Separator4 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #LootMult {
          Text: "Loot: x1.0";
          Style: (
            FontSize: 12,
            TextColor: #55FF55,
            Alignment: Center
          );
          Anchor: (Width: 110, Height: 22);
        }
      }
    }

    Group #EssenceBarContainer {
      Anchor: (Width: 720, Height: 12, Left: 0, Top: 16);
      LayoutMode: Center;

      Group #EssenceBarGroup {
        Anchor: (Width: 318, Height: 14);
        Background: "NewEssenceBarBackground.png";

        Group #EssenceBar {
          Anchor: (Width: 0, Height: 14, Left: 159, Top: 0);
          Background: "NewEssenceBarFill.png";
        }
        Group #EssenceBarEffect {
          Anchor: (Width: 0, Height: 12, Left: 159, Top: 1);
          Background: "NewEssenceBarEffect.png";
        }
      }
    }
  }
}
