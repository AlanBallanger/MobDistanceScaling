@EssenceBarFill = "NewEssenceBarFill.png";

Group {
  LayoutMode: Center;

  Group #ZoneHudRoot {
    Anchor: (Width: 600, Top: 36);
    LayoutMode: Top;

    Group #ZoneBar {
      Anchor: (Width: 590, Height: 26, Left: 0, Top: 0);
      Background: (Color: #202C3C);
      LayoutMode: Center;
      Padding: (Vertical: 0, Horizontal: 12);

      Group #InfoRow {
        Anchor: (Height: 22);
        LayoutMode: Left;

        Label #ZoneName {
          Text: "Zone Info - 0m";
          Style: (
            FontSize: 12,
            RenderBold: true,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 150, Height: 22);
        }

        Label #Separator1 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #Essence {
          Text: "Essence: 0/1000";
          Style: (
            FontSize: 12,
            RenderBold: true,
            TextColor: #FFFF55,
            Alignment: Center
          );
          Anchor: (Width: 130, Height: 22);
        }

        Label #Separator2 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #HPMult {
          Text: "";
          Style: (
            FontSize: 12,
            TextColor: #FF5555,
            Alignment: Center
          );
          Anchor: (Width: 70, Height: 22);
        }

        Label #Separator3 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #DMGMult {
          Text: "";
          Style: (
            FontSize: 12,
            TextColor: #FFAA55,
            Alignment: Center
          );
          Anchor: (Width: 70, Height: 22);
        }

        Label #Separator4 {
          Text: "|";
          Style: (
            FontSize: 12,
            TextColor: #FFFFFF,
            Alignment: Center
          );
          Anchor: (Width: 18, Height: 22);
        }

        Label #LootMult {
          Text: "";
          Style: (
            FontSize: 12,
            TextColor: #55FF55,
            Alignment: Center
          );
          Anchor: (Width: 70, Height: 22);
        }
      }
    }

    Group #EssenceBarHost {
      Anchor: (Width: 600, Height: 48, Left: 0, Top: 16);
      LayoutMode: Center;

      Group #EssenceBarWrapper {
        Anchor: (Width: 374, Height: 48);

        Group #EssenceIconLeft {
          Anchor: (Width: 18, Height: 18, Left: 5, Top: -5);
          Background: "NoyauIcone.png";
        }

        Group #EssenceBarGroup {
          Anchor: (Width: 320, Height: 48, Left: 27, Top: 0);

          Group #EssenceBarBackground {
            Anchor: (Width: 320, Height: 14, Left: 0, Top: 0);
            Background: "NewEssenceBarBackground.png";

            Group #EssenceBarNoyau {
              Anchor: (Width: 0, Height: 14, Left: 160, Top: 0);
              Background: "NewEssenceBarFillNoyau.png";
            }
            Group #EssenceBarFracture {
              Anchor: (Width: 0, Height: 14, Left: 160, Top: 0);
              Background: "NewEssenceBarFillFracture.png";
            }
          }

          Label #EssenceValue {
            Text: "0";
            Style: (
              FontSize: 11,
              RenderBold: true,
              TextColor: #FFFFFF,
              Alignment: Center
            );
            Anchor: (Width: 60, Height: 14, Top: 30);
          }
        }

        Group #EssenceIconRight {
          Anchor: (Width: 18, Height: 18, Left: 355, Top: -5);
          Background: "FractureIcon.png";
        }
      }
    }
  }
}
