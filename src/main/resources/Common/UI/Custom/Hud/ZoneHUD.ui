@EssenceBarFill = "NewEssenceBarFill.png";

Group {
  LayoutMode: Center;

  Group #ZoneHudRoot {
    Anchor: (Width: 600, Top: 40);

    Group #ZoneBar {
      Anchor: (Width: 600, Height: 36, Left: 0, Top: 0);
      Background: (Color: #00000088);
      LayoutMode: Top;
      Padding: (Vertical: 6, Horizontal: 12);

      Group #InfoRow {
        Anchor: (Height: 20);
        LayoutMode: Left;

      Label #ZoneName {
        Text: "Zone Info - 0m";
        Style: (
          FontSize: 13,
          RenderBold: true,
          TextColor: #FFFFFF,
          Alignment: Center
        );
        Anchor: (Width: 140);
      }

      Label #Separator1 {
        Text: "|";
        Style: (
          FontSize: 13,
          TextColor: #666666,
          Alignment: Center
        );
        Anchor: (Width: 20);
      }

      Label #Essence {
        Text: "Essence: 0/1000";
        Style: (
          FontSize: 12,
          RenderBold: true,
          TextColor: #FFFF55,
          Alignment: Center
        );
        Anchor: (Width: 130);
      }

      Label #Separator2 {
        Text: "|";
        Style: (
          FontSize: 13,
          TextColor: #666666,
          Alignment: Center
        );
        Anchor: (Width: 20);
      }

      Label #HPMult {
        Text: "HP: x1.0";
        Style: (
          FontSize: 12,
          TextColor: #FF5555,
          Alignment: Center
        );
        Anchor: (Width: 70);
      }

      Label #Separator3 {
        Text: "|";
        Style: (
          FontSize: 13,
          TextColor: #666666,
          Alignment: Center
        );
        Anchor: (Width: 20);
      }

      Label #DMGMult {
        Text: "DMG: x1.0";
        Style: (
          FontSize: 12,
          TextColor: #FFAA55,
          Alignment: Center
        );
        Anchor: (Width: 80);
      }

      Label #Separator4 {
        Text: "|";
        Style: (
          FontSize: 13,
          TextColor: #666666,
          Alignment: Center
        );
        Anchor: (Width: 20);
      }

      Label #LootMult {
        Text: "Loot: x1.0";
        Style: (
          FontSize: 12,
          TextColor: #55FF55,
          Alignment: Center
        );
        Anchor: (Width: 80);
      }
      }

    }

    Group #EssenceBarRow {
      Anchor: (Width: 600, Height: 12, Left: 0, Top: 42);
      LayoutMode: Center;

      Group #EssenceBarContainer {
        Anchor: (Width: 318, Height: 12);
        Background: "NewEssenceBarBackground.png";

        ProgressBar #EssenceBar {
          Anchor: (Width: 318, Height: 12);
          BarTexturePath: @EssenceBarFill;
          Visible: true;
        }
        ProgressBar #EssenceBarEffect {
          Anchor: (Width: 318, Height: 12);
          BarTexturePath: "EssenceBarEffect.png";
        }
      }
    }
  }
}
