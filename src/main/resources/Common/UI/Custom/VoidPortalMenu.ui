$C = "Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 980, Height: 670);

    #Title {
      Group {
        LayoutMode: Left;

        Label #MenuTitle {
          FlexWeight: 1;
          Text: "VOID PORTAL - Choisis une Zone";
          Style: (FontSize: 20, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 30, Height: 30, Top: 2, Right: 10);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }

    #Content {
      Padding: (Top: 12, Bottom: 12, Left: 12, Right: 12);
      LayoutMode: Top;

      Group #Row1 {
        LayoutMode: Left;
        Anchor: (Height: 195, Bottom: 8);

        Group #ZoneCard1 {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Background: (Color: #0b1624);
          OutlineColor: #2a3a4a;
          OutlineSize: 2;
          LayoutMode: Top;

          Group #ZoneImg1 {
            Anchor: (Height: 92);
            Background: "varyon_zones.png";
            Padding: (Top: 5, Left: 7);
            Label {
              Text: "Zone 1";
              Style: (FontSize: 14, RenderBold: true, TextColor: #ffffff);
            }
          }

          Group {
            Padding: (Left: 5, Right: 5, Top: 5, Bottom: 5);
            LayoutMode: Top;

            Button #ZoneMain1 {
              Anchor: (Height: 46, Bottom: 4);
              Style: ButtonStyle(
                Default: (Background: (Color: #1a5a9a)),
                Hovered: (Background: (Color: #2a6aaa)),
                Pressed: (Background: (Color: #104878))
              );
              OutlineColor: #0a3060;
              OutlineSize: 1;
              Group {
                LayoutMode: Middle;
                Group {
                  LayoutMode: Top;
                  Label #ZoneMainTitle1 {
                    Anchor: (Bottom: 1);
                    Text: "TP aleatoirement dans la zone 1";
                    Style: (FontSize: 11, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center);
                  }
                  Label #ZoneMainPrice1 {
                    Text: "";
                    Style: (FontSize: 10, TextColor: #7a8a9a, HorizontalAlignment: Center);
                  }
                }
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 38);

              Button #ZonePvP1 {
                FlexWeight: 1;
                Anchor: (Right: 3);
                Style: ButtonStyle(
                  Default: (Background: (Color: #6a1818)),
                  Hovered: (Background: (Color: #7a2828)),
                  Pressed: (Background: (Color: #550f0f))
                );
                OutlineColor: #3a0808;
                OutlineSize: 1;
                Group {
                  LayoutMode: Middle;
                  Group {
                    LayoutMode: Top;
                    Label {
                      Anchor: (Bottom: 1);
                      Text: "Choix PvP actif";
                      Style: (FontSize: 10, RenderBold: true, TextColor: #ffaaaa, HorizontalAlignment: Center);
                    }
                    Label #ZonePvPPrice1 {
                      Text: "";
                      Style: (FontSize: 9, TextColor: #7a8a9a, HorizontalAlignment: Center);
                    }
                  }
                }
              }

              Button #ZoneSafe1 {
                FlexWeight: 1;
                Style: ButtonStyle(
                  Default: (Background: (Color: #185a28)),
                  Hovered: (Background: (Color: #286a38)),
                  Pressed: (Background: (Color: #0f4018))
                );
                OutlineColor: #083818;
                OutlineSize: 1;
                Group {
                  LayoutMode: Middle;
                  Group {
                    LayoutMode: Top;
                    Label {
                      Anchor: (Bottom: 1);
                      Text: "Choix PvP inactif";
                      Style: (FontSize: 10, RenderBold: true, TextColor: #aaffaa, HorizontalAlignment: Center);
                    }
                    Label #ZoneSafePrice1 {
                      Text: "";
                      Style: (FontSize: 9, TextColor: #7a8a9a, HorizontalAlignment: Center);
                    }
                  }
                }
              }
            }
          }
        }
