            Hovered: (Background: (Color: #2a4a6a)),
            Pressed: (Background: (Color: #1a3050))
          );
          OutlineColor: #2a3a4a;
          OutlineSize: 2;
          Group {
            LayoutMode: Middle;
            Label { Text: "Zone 8"; Style: (FontSize: 17, RenderBold: true, TextColor: #88ccff, HorizontalAlignment: Center); }
          }
        }

        Button #Zone9 {
          FlexWeight: 1;
          Anchor: (Right: 8);
          Style: ButtonStyle(
            Default: (Background: (Color: #1a2a3a)),
            Hovered: (Background: (Color: #2a4a6a)),
            Pressed: (Background: (Color: #1a3050))
          );
          OutlineColor: #2a3a4a;
          OutlineSize: 2;
          Group {
            LayoutMode: Middle;
            Label { Text: "Zone 9"; Style: (FontSize: 17, RenderBold: true, TextColor: #88ccff, HorizontalAlignment: Center); }
          }
