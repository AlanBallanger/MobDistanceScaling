                    Anchor: (Top: 6);
                                        Label #ZoneSafePrice1 {
                      Text: "";
                      Style: (FontSize: 10, TextColor: #d0ead8, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
                }
              }
            }
          }
