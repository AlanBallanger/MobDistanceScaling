$C = "Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 980, Height: 670);
    Background: (Color: #16102a);

    #Title {
      Group {
        LayoutMode: Left;

        Label #MenuTitle {
          FlexWeight: 1;
          Text: "Téléportation zones Varyon";
          Style: (FontSize: 20, RenderBold: true, TextColor: #f2ecff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 30, Height: 30, Top: 2, Right: 10);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 18, TextColor: #f2ecff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #7a3448), LabelStyle: (FontSize: 18, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }

    #Content {
      Padding: (Top: 12, Bottom: 12, Left: 12, Right: 12);
      LayoutMode: Top;
      Background: (Color: #1a142e);

      Group #Row1 {
        LayoutMode: Left;
        Anchor: (Height: 244, Bottom: 8);

        Group #ZoneCard1 {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Background: (Color: #201a36);
          OutlineColor: #3d3458;
          OutlineSize: 2;
          LayoutMode: Top;

          Group {
            Anchor: (Height: 26);
            Background: (Color: #2a2448);
            Padding: (Left: 8, Right: 8);
            LayoutMode: Middle;
            Label {
              Text: "Zone 1";
              Style: (FontSize: 13, RenderBold: true, TextColor: #efe8ff, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }

          Group #ZoneImg1 {
            Anchor: (Height: 88);
            Background: "varyon_zones.png";
          }

          Group #ZoneRadius1 {
            Anchor: (Height: 40);
            Background: (Color: #2a2440);
            Padding: (Left: 6, Right: 6, Top: 4, Bottom: 4);
            LayoutMode: Top;
            Label #ZoneRadiusTitle1 {
              Text: "RAYON";
              Style: (FontSize: 10, RenderBold: true, TextColor: #c4b8e8, HorizontalAlignment: Center);
            }
            Label #ZoneRadiusValue1 {
              Text: "";
              Style: (FontSize: 11, TextColor: #f0ecf8, HorizontalAlignment: Center, Wrap: true);
            }
          }

          Group {
            Padding: (Left: 5, Right: 5, Top: 6, Bottom: 6);
            LayoutMode: Top;

            Group {
              LayoutMode: Left;
              Anchor: (Height: 72);

              Button #ZoneMain1 {
                FlexWeight: 1;
                Anchor: (Right: 4);
                Style: ButtonStyle(
                  Default: (Background: (Color: #242038)),
                  Hovered: (Background: (Color: #2e2a48)),
                  Pressed: (Background: (Color: #18162a))
                );
                OutlineColor: #141228;
                OutlineSize: 1;
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 4, Bottom: 4, Left: 3, Right: 3);
                  Group {
                    LayoutMode: Middle;
                    Label #ZoneMainTitle1 {
                      Text: "Aléatoire";
                      Style: (FontSize: 11, RenderBold: true, TextColor: #c8c2e0, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
                  Group #ZoneMainPriceRow1 {
                    LayoutMode: Middle;
                    Anchor: (Top: 6);
                                        Label #ZoneMainPrice1 {
                      Text: "";
                      Style: (FontSize: 10, TextColor: #dcd4f0, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
                }
              }

              Button #ZonePvP1 {
                FlexWeight: 1;
                Anchor: (Right: 4);
                Style: ButtonStyle(
                  Default: (Background: (Color: #521420)),
                  Hovered: (Background: (Color: #621a28)),
                  Pressed: (Background: (Color: #3a0c14))
                );
                OutlineColor: #300810;
                OutlineSize: 1;
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 4, Bottom: 4, Left: 3, Right: 3);
                  Group {
                    LayoutMode: Middle;
                    Label {
                      Text: "PvP actif";
                      Style: (FontSize: 11, RenderBold: true, TextColor: #e09090, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
                  Group #ZonePvPPriceRow1 {
                    LayoutMode: Middle;
                    Anchor: (Top: 6);
                                        Label #ZonePvPPrice1 {
                      Text: "";
                      Style: (FontSize: 10, TextColor: #e8d0d0, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
                }
              }

              Button #ZoneSafe1 {
                FlexWeight: 1;
                Style: ButtonStyle(
                  Default: (Background: (Color: #1e5c2e)),
                  Hovered: (Background: (Color: #2a7038)),
                  Pressed: (Background: (Color: #144522))
                );
                OutlineColor: #0c3818;
                OutlineSize: 1;
                Group {
                  LayoutMode: Top;
                  Padding: (Top: 4, Bottom: 4, Left: 3, Right: 3);
                  Group {
                    LayoutMode: Middle;
                    Label {
                      Text: "PvP inactif";
                      Style: (FontSize: 11, RenderBold: true, TextColor: #a8e8a8, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: false);
                    }
                  }
